{
  "$schema": "https://opencode.ai/config.json",
  "model": "lab/gpt-5-nano-sticky",
  "providers": {
    "lab": {
      "name": "Standalone AI Gateway session-header probe",
      "package": "@opencode/ai/providers/openai/chat",
      "settings": {
        "baseURL": "https://<assigned-runtime-hostname>/default/models/openai/v1",
        "apiKey": "{env:AI_GATEWAY_KEY}"
      },
      "models": {
        "gpt-5-nano-sticky": {
          "body": {
            "reasoning_effort": "minimal",
            "max_completion_tokens": 512
          }
        }
      }
    }
  }
}
